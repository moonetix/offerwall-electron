# Copy to .env and fill in. Never commit .env. Server only: nothing here goes into the app.

# Moonetix dashboard: Offerwalls, your offerwall, Integration
MOONETIX_APP_ID=your-app-id
MOONETIX_LINK_SALT=your-link-hash-salt
# Moonetix dashboard: Postback page
MOONETIX_POSTBACK_KEY=your-postback-secret-key

# Optional
PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./data.sqlite
CURRENCY_NAME=Points
SESSION_DAYS=30
# Returned in every postback as {sub1}. Not signed: use it for reports, never for money.
MOONETIX_SUB1=desktop
